{
  "mcpServers": {
    "hwops": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-server/dist/index.js"],
      "env": {
        "HWOPS_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "HWOPS_OFFLINE": "${user_config.offline_mode}",
        "HWOPS_TLS_VERIFY": "${user_config.tls_verify}",
        "HWOPS_CFG_REDFISH_USER": "${user_config.redfish_username}",
        "HWOPS_CFG_REDFISH_AUTH": "${user_config.redfish_password}",
        "HWOPS_CFG_ONEVIEW_BASE": "${user_config.oneview_host}",
        "HWOPS_CFG_ONEVIEW_USER": "${user_config.oneview_username}",
        "HWOPS_CFG_ONEVIEW_AUTH": "${user_config.oneview_password}",
        "HWOPS_CFG_ONEVIEW_API": "${user_config.oneview_api_version}",
        "HWOPS_CFG_OME_BASE": "${user_config.ome_host}",
        "HWOPS_CFG_OME_USER": "${user_config.ome_username}",
        "HWOPS_CFG_OME_AUTH": "${user_config.ome_password}",
        "HWOPS_CFG_SNOW_BASE": "${user_config.snow_instance}",
        "HWOPS_CFG_SNOW_USER": "${user_config.snow_username}",
        "HWOPS_CFG_SNOW_AUTH": "${user_config.snow_password}",
        "HWOPS_CFG_SNOW_BEARER": "${user_config.snow_token}",
        "HWOPS_CFG_NETBOX_BASE": "${user_config.netbox_url}",
        "HWOPS_CFG_NETBOX_BEARER": "${user_config.netbox_token}",
        "HWOPS_CFG_SNMP_READ": "${user_config.snmp_community}",
        "HWOPS_CFG_SWITCH_USER": "${user_config.switch_username}",
        "HWOPS_CFG_SWITCH_AUTH": "${user_config.switch_password}",
        "HWOPS_CFG_SWITCH_BEARER": "${user_config.switch_token}",
        "HWOPS_CFG_SWITCH_TARGET": "${user_config.switch_apply_url}",
        "HWOPS_CFG_BUNDLE_SIGNER": "${user_config.bundle_signing_key}",
        "HWOPS_CFG_BUNDLE_VERIFIER": "${user_config.bundle_public_key}"
      }
    }
  }
}
